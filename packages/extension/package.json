{
  "name": "@infodetector/extension",
  "version": "0.1.0",
  "private": true,
  "description": "SecretSentry: warns you before secrets leave your browser for an AI chat.",
  "author": "Kalpesh",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:e2e": "node scripts/build.ts --e2e",
    "test": "node --test \"tests/*.test.ts\"",
    "test:e2e": "node scripts/build.ts --e2e && node --test --test-timeout=120000 tests/e2e/extension.e2e.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@infodetector/core": "0.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.2"
  }
}
